{
  "type": "module",
  "scripts": {
    "start": "node ./server.ts",
    "dev": "node --watch --env-file=.env ./server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "seed": "tsx --env-file=.env ./prisma/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true
  }
}
