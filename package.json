{
  "name": "gefina",
  "version": "0.0.0",
  "description": "Sistema de gestão de contas a receber.",
  "author": "Alexandre Rodrigues Alves",
  "scripts": {
    "check": "tsc --noEmit && biome check ./",
    "fix": "biome check --write ./",
    "fix:unsafe": "biome check --write --unsafe ./"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
