{
  "name": "gefina",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "node ./api/server.ts",
    "dev": "node --watch --env-file=.env ./api/server.ts",
    "check": "tsc --noEmit && biome check ./",
    "fix": "biome check --write ./",
    "fix:unsafe": "biome check --write --unsafe ./"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react-router-dom": "^7.18.4"
  }
}
